"""
Starter wiring smoke test. Add real project tests before relying on this for CI.
"""
type ProjectCi {
  """
  Verify that this module can execute a container. NOT a project test suite.
  """
  pub engineSmoke: Void @check {
    container
      .from("alpine:3.22")
      .withExec(["sh", "-c", "printf 'Dagger engine smoke test passed\\n'"])
      .sync
    null
  }
}
